{
  "name": "@kayf/ui",
  "version": "0.5.1",
  "description": "Modern, framework-agnostic Web Components for expressive dark interfaces.",
  "type": "module",
  "main": "dist/kayf-ui.cjs",
  "module": "dist/kayf-ui.esm.js",
  "types": "dist/index.d.ts",
  "sideEffects": true,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/kayf-ui.esm.js",
      "require": "./dist/kayf-ui.cjs"
    }
  },
  "scripts": {
    "build": "rollup -c --forceExit",
    "dev": "rollup -c -w",
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build",
    "chromatic": "npx chromatic --project-token=$CHROMATIC_PROJECT_TOKEN",
    "type-check": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "web-components",
    "ui",
    "game-ui",
    "design-system",
    "dark-ui",
    "interactive-components",
    "typescript"
  ],
  "author": "kayf",
  "license": "MIT",
  "homepage": "https://github.com/vKAYFv/kayf-ui#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vKAYFv/kayf-ui.git"
  },
  "bugs": {
    "url": "https://github.com/vKAYFv/kayf-ui/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "devDependencies": {
    "@rollup/plugin-typescript": "^12.3.0",
    "@storybook/addon-a11y": "^10.6.0",
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/web-components-vite": "^10.6.0",
    "chromatic": "^15.2.0",
    "lit": "^3.0.0",
    "rollup": "^4.0.0",
    "storybook": "^10.6.0",
    "tslib": "^2.8.1",
    "typescript": "^5.0.0"
  }
}
