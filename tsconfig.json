{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "declaration": true,
    "declarationDir": "./dist",
    "outDir": "./dist",
    "lib": ["ES2020", "DOM"],
    "experimentalDecorators": true,
    "useDefineForClassFields": true
  },
  "include": ["src/index.ts", "src/core/**/*.ts", "src/components/**/*.ts"],
  "exclude": ["node_modules", "dist", "src/stories"]
}
